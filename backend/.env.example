# Server
PORT=3001
NODE_ENV=development

# Neon PostgreSQL (server-side only - never expose to client code)
DATABASE_URL=

# JWT - change this secret to a long random string in production
JWT_SECRET=super-secret-foodie-jwt-key-change-me-in-production
JWT_EXPIRES_IN=7d

# Admin account created by the seed script
ADMIN_EMAIL=admin@foodie.com
ADMIN_PASSWORD=Admin@12345

# CORS origins (comma separated). Empty = allow all in development.
CORS_ORIGINS=

# Uploads directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
